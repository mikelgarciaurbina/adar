---
// The sky behind the landing page: night at the top, the blue hour in the middle, dawn by the download.
// home.js sets --stars, --deep, --dawn and --sun from the scroll position.
---
<div class="sky" aria-hidden="true">
  <div class="sky__deep"></div>
  <div class="sky__dawn"></div>
  <div class="sky__sun"></div>
  <div class="sky__stars"></div>
  <div class="sky__stars sky__stars--far"></div>
</div>
