---
import Icon from './Icon.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { REPO_URL, url } from '../lib/url';
import { pageUrl, anchor, type Locale, type PageKey } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { lang: Locale; page: PageKey }
const { lang, page } = Astro.props;
const t = ui[lang];
// On the landing page the first links are anchors into the page itself.
const links: [string, string][] = page === 'home'
  ? [[t.nav.name, `#${anchor('name', lang)}`], [t.nav.features, `#${anchor('features', lang)}`], [t.nav.download, `#${anchor('download', lang)}`],
     [t.nav.roadmap, pageUrl('roadmap', lang)], [t.nav.design, pageUrl('design', lang)]]
  : [[t.nav.features, pageUrl('home', lang, 'features')], [t.nav.download, pageUrl('home', lang, 'download')], [t.nav.roadmap, pageUrl('roadmap', lang)],
     [t.nav.changelog, pageUrl('roadmap', lang, 'changelog')], [t.nav.design, pageUrl('design', lang)]];
const active = page === 'home' ? '' : pageUrl(page, lang);
const downloadHref = page === 'home' ? `#${anchor('download', lang)}` : pageUrl('home', lang, 'download');
---
<header class="nav">
  <div class="wrap nav__inner">
    <a class="brand" href={pageUrl('home', lang)} aria-label={t.home}><img src={url('assets/adar-lockup.svg')} width="94" height="32" alt="Adar"></a>
    <nav class="nav__links" id="site-nav" aria-label={t.navAria}>
      {links.map(([label, href]) => <a href={href} aria-current={href === active ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav__cta">
      <LanguageSwitch lang={lang} page={page} />
      <a class="btn btn--ghost gh-stars" href={REPO_URL} aria-label={t.github}>
        <Icon name="star" /><span>GitHub</span><span class="btn__meta" data-gh="stars"></span>
      </a>
      <a class="btn btn--primary" href={downloadHref}><Icon name="download" />{t.download}</a>
    </div>
    <button class="nav__toggle" type="button" aria-label={t.menu} aria-expanded="false" aria-controls="site-nav"><span></span><span></span></button>
  </div>
</header>
