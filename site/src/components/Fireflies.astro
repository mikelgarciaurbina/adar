---
// A few slow, glowing fireflies for the night chapters (pure CSS; still when motion is reduced).
interface Props { count?: number; seed?: number }
const { count = 14, seed = 3 } = Astro.props;
let s = seed;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const flies = Array.from({ length: count }, () => ({
  x: (rand() * 100).toFixed(1), y: (rand() * 100).toFixed(1),
  d: (rand() * -12).toFixed(2), t: (9 + rand() * 9).toFixed(2), dx: (rand() * 60 - 30).toFixed(0), dy: (rand() * -50 - 10).toFixed(0),
}));
---
<div class="fireflies" aria-hidden="true">
  {flies.map((f) => <i style={`--x:${f.x}%;--y:${f.y}%;--d:${f.d}s;--t:${f.t}s;--dx:${f.dx}px;--dy:${f.dy}px`} />)}
</div>
