---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import geist from '../fonts/geist.woff2?url';
import serifItalic from '../fonts/instrument-serif-italic.woff2?url';
import { url, SITE_URL } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Page path below the base, for the canonical URL ('' is the landing page). */
  path: string;
  current?: 'home' | 'roadmap' | 'design';
  ogTitle?: string;
  ogDescription?: string;
  /** The 404 page: no navigation and not indexed. */
  bare?: boolean;
}
const { title, description, path, current = 'home', ogTitle = title, ogDescription = description, bare = false } = Astro.props;
// Scripts are bundled files (no inline scripts); styles may use inline style attributes for per-element variables.
const csp = [
  "default-src 'self'", "script-src 'self'", "style-src 'self' 'unsafe-inline'", "img-src 'self' data:", "font-src 'self'",
  "connect-src 'self' https://api.github.com", "object-src 'none'", "base-uri 'none'", "form-action 'none'",
].join('; ');
const canonical = SITE_URL + path;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content={csp}>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#0a0d0c">
  {bare ? <meta name="robots" content="noindex"> : <>
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Adar">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content={`${SITE_URL}assets/og.jpg`}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content={`${SITE_URL}assets/og.jpg`}>
  </>}
  <link rel="icon" href={url('assets/favicon.svg')} type="image/svg+xml">
  <link rel="apple-touch-icon" href={url('assets/apple-touch-icon.png')}>
  <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {!bare && <Nav current={current} />}
  <slot />
  {!bare && <Footer current={current} />}
</body>
</html>
