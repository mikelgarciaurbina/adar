---
// GitHub Pages serves this for any missing path, so every link is absolute to the site base.
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Branch not found — Adar" description="This page doesn’t exist." path="404.html" bare>
  <main class="lost" id="main">
    <div class="lost__inner">
      <img src={url('assets/adar-mark.svg')} width="72" height="72" alt="">
      <h1>This branch <span class="serif">never grew.</span></h1>
      <pre><code><b>fatal:</b> couldn't find remote ref for this page</code></pre>
      <p class="muted">The page you were looking for isn’t here — maybe it was renamed, or it only exists in someone’s local checkout.</p>
      <div class="lost__ctas">
        <a class="btn btn--primary" href={url()}>Back to the trunk</a>
        <a class="btn btn--ghost" href={url('roadmap.html')}>See the roadmap</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .lost { min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 48px var(--gutter); background: radial-gradient(50% 40% at 50% 35%, rgb(197 245 106 / 0.1), transparent 70%), var(--bg); }
  .lost__inner { display: grid; justify-items: center; gap: var(--space-5); max-width: 560px; }
  .lost img { width: 72px; height: 72px; opacity: 0.9; filter: drop-shadow(0 0 24px rgb(197 245 106 / 0.4)); }
  .lost h1 { font-size: var(--text-3xl); letter-spacing: var(--tracking-tight); line-height: 1; }
  .lost h1 .serif { color: var(--accent-text); }
  .lost pre { margin: 0; padding: 14px 18px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--bg-sunken); color: var(--text-3); font-size: var(--text-sm); white-space: pre-wrap; text-align: left; }
  .lost pre b { color: var(--txingar); font-weight: 500; }
  .lost__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
</style>

<script>
  import '../scripts/site.js';
</script>
