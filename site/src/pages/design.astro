---
// Basoa, the design system: the extruded 3D mark and the brand rules are static; the colour, space and
// motion documentation is generated in the browser from the live CSS variables (scripts/design.js), so
// it always shows what tokens.css really says.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/design.css';
import { url } from '../lib/url';
import sprite from '../icons/icons.svg?raw';

const icons = [...sprite.matchAll(/<symbol[^>]*\bid="([\w-]+)"/g)].map((m) => m[1]);
---
<Base
  title="Basoa — the Adar design system"
  description="Basoa is Adar's open design system: the antler-and-branch logo, a palette named after the Basque forest, type, motion, icons, components and the visual language of the commit graph."
  ogDescription="Logo, colour, type, motion, icons and components behind Adar. Open and free to reuse."
  path="design.html"
  current="design"
>
  <main id="main">
    <section class="ds-hero" aria-labelledby="ds-title">
      <div class="wrap ds-hero__grid">
        <div class="ds-hero__copy">
          <p class="eyebrow reveal">Design system · v1</p>
          <h1 id="ds-title" class="reveal" style="--delay:80ms"><span class="serif" lang="eu">Basoa</span></h1>
          <p class="ds-hero__lede reveal" style="--delay:160ms"><i lang="eu">Basoa</i> is Basque for <b>forest</b> — where branches, antlers and moss live. It is the visual language of Adar: one mark, a palette named after the woods at night, three typefaces and a graph that everything else grows from.</p>
          <div class="ds-hero__ctas reveal" style="--delay:240ms">
            <a class="btn btn--primary btn--lg" href="#downloads"><Icon name="download" />Get the assets</a>
            <a class="btn btn--ghost btn--lg" href={url('tokens.css')}><Icon name="code" />tokens.css</a>
          </div>
        </div>
        <figure class="mark3d reveal" data-mark3d aria-label="The Adar mark, extruded in 3D">
          <div class="mark3d__stage" data-stage></div>
          <div class="mark3d__floor" aria-hidden="true"></div>
          <figcaption class="fig mono"><span>fig. 5</span> the mark, extruded — drag to turn it</figcaption>
        </figure>
      </div>
    </section>

    <div class="wrap ds-layout">
      <nav class="ds-toc" aria-label="On this page">
        <p class="ds-toc__title mono">Contents</p>
        <ol>
          <li><a href="#principles">Principles</a></li>
          <li><a href="#logo">Logo</a></li>
          <li><a href="#color">Colour</a></li>
          <li><a href="#type">Typography</a></li>
          <li><a href="#space">Space &amp; shape</a></li>
          <li><a href="#motion">Motion</a></li>
          <li><a href="#icons">Icons</a></li>
          <li><a href="#graph">Graph language</a></li>
          <li><a href="#components">Components</a></li>
          <li><a href="#voice">Voice</a></li>
          <li><a href="#downloads">Downloads</a></li>
        </ol>
      </nav>

      <div class="ds-content">
        <!-- Principles -->
        <section class="ds-sec" id="principles" aria-labelledby="h-principles">
          <header class="ds-sec__head"><p class="eyebrow">01</p><h2 id="h-principles">Principles</h2></header>
          <div class="ds-principles">
            <article class="card ds-principle reveal"><h3>Grown, not built.</h3><p>Shapes branch and taper like living things. Curves are soft, ends are round, nothing is boxy for its own sake.</p></article>
            <article class="card ds-principle reveal" style="--delay:60ms"><h3>The history is the hero.</h3><p>The commit graph is the most important picture. Colour, glow and motion exist to make it readable.</p></article>
            <article class="card ds-principle reveal" style="--delay:120ms"><h3>Calm until it matters.</h3><p>Night-dark surfaces and fog-grey text; fern only where the eye should go. One accent per view.</p></article>
            <article class="card ds-principle reveal" style="--delay:180ms"><h3>Basque at heart, open to all.</h3><p>Names and small details come from euskara; the product speaks plain English and will speak more languages.</p></article>
          </div>
        </section>

        <!-- Logo -->
        <section class="ds-sec" id="logo" aria-labelledby="h-logo">
          <header class="ds-sec__head"><p class="eyebrow">02</p><h2 id="h-logo">Logo</h2>
            <p>A pair of antlers drawn with git lanes. A root commit, one fork, two beams and two tines — and a commit at every tip. Read it as a deer, a branching tree or <code>git log --graph</code>: all three are <i lang="eu">adar</i>.</p></header>

          <figure class="construct card reveal">
            <svg class="construct__svg" viewBox="-40 -6 144 76" role="img" aria-labelledby="construct-title">
              <title id="construct-title">Construction of the Adar mark on a 64 unit grid</title>
              <defs>
                <pattern id="grid4" width="4" height="4" patternUnits="userSpaceOnUse"><path d="M4 0H0V4" fill="none" stroke="currentColor" stroke-opacity=".07" stroke-width=".2"/></pattern>
              </defs>
              <rect x="0" y="0" width="64" height="64" fill="url(#grid4)"/>
              <rect x="0" y="0" width="64" height="64" fill="none" stroke="currentColor" stroke-opacity=".18" stroke-width=".25" stroke-dasharray="1 1"/>
              <path d="M32 0V64M0 32H64" stroke="currentColor" stroke-opacity=".14" stroke-width=".25"/>
              <g class="construct__mark" fill="none" stroke-width="4.6" stroke-linecap="round">
                <path d="M32 55V45"/><path d="M32 45C25 42 12 38 11 24C10.5 17 12 12 15.5 7.5"/><path d="M32 45C39 42 52 38 53 24C53.5 17 52 12 48.5 7.5"/><path d="M11.6 31C18 29.5 23 26 24.5 19.5"/><path d="M52.4 31C46 29.5 41 26 39.5 19.5"/>
              </g>
              <g class="construct__nodes"><circle cx="15.5" cy="7.5" r="4.4"/><circle cx="48.5" cy="7.5" r="4.4"/><circle cx="24.6" cy="19" r="4.4"/><circle cx="39.4" cy="19" r="4.4"/><circle cx="32" cy="55.5" r="5.4"/></g>
              <g class="construct__guides" fill="none" stroke-width=".3"><circle cx="15.5" cy="7.5" r="7"/><circle cx="32" cy="55.5" r="8"/><path d="M32 45h-14"/></g>
              <g class="construct__labels">
                <path d="M23.5 55.5H-4"/><text x="-6" y="56.5" text-anchor="end">root commit</text>
                <path d="M24 45H-4"/><text x="-6" y="46" text-anchor="end">fork</text>
                <path d="M11 24H-4"/><text x="-6" y="25" text-anchor="end">beam · main</text>
                <path d="M53.5 7.5H68"/><text x="70" y="8.5">commit</text>
                <path d="M44 19H68"/><text x="70" y="20">tine · feature</text>
                <path d="M55 31H68"/><text x="70" y="32">stroke 4.6 / 64</text>
                <path d="M38 55.5H68"/><text x="70" y="56.5">node r 5.4 · tips 4.4</text>
              </g>
            </svg>
            <figcaption>Drawn on a 64-unit grid with a single 4.6-unit round stroke. Tips are 4.4-unit commits; the root is slightly larger. Everything is symmetric about the centre lane.</figcaption>
          </figure>

          <div class="logos">
            <figure class="logo-card logo-card--night reveal"><img src={url('assets/adar-lockup.svg')} width="188" height="64" alt="Adar lockup on night"><figcaption>Lockup · night</figcaption></figure>
            <figure class="logo-card logo-card--day reveal" style="--delay:60ms"><img src={url('assets/adar-lockup-light.svg')} width="188" height="64" alt="Adar lockup on day"><figcaption>Lockup · day</figcaption></figure>
            <figure class="logo-card logo-card--fern reveal" style="--delay:120ms"><img src={url('assets/adar-mark-mono.svg')} width="80" height="80" alt="Adar mark on fern"><figcaption>Mark · on fern</figcaption></figure>
            <figure class="logo-card logo-card--tile reveal" style="--delay:180ms"><img src={url('assets/favicon.svg')} width="96" height="96" alt="Adar app tile"><figcaption>Tile · favicon &amp; app</figcaption></figure>
          </div>

          <div class="ds-rules">
            <div class="ds-rule card"><h3>Clear space</h3><div class="clear-space" aria-hidden="true"><img src={url('assets/adar-mark.svg')} width="64" height="64" alt=""></div><p>Keep one tip-node (¼ of the mark) free on every side.</p></div>
            <div class="ds-rule card"><h3>Minimum size</h3><div class="min-size" aria-hidden="true"><img src={url('assets/adar-mark.svg')} width="16" height="16" alt=""><img src={url('assets/adar-mark.svg')} width="24" height="24" alt=""><img src={url('assets/adar-lockup.svg')} width="70" height="24" alt=""></div><p>Mark from 16 px, lockup from 24 px tall.</p></div>
            <div class="ds-rule ds-rule--dont card"><h3>Don’t</h3><div class="donts" aria-hidden="true">
              <span><img src={url('assets/adar-mark.svg')} width="40" height="40" alt="" style="transform:rotate(30deg)"><i>rotate</i></span>
              <span><img src={url('assets/adar-mark.svg')} width="40" height="40" alt="" style="transform:scaleX(1.5)"><i>stretch</i></span>
              <span><img src={url('assets/adar-mark.svg')} width="40" height="40" alt="" style="filter:hue-rotate(160deg)"><i>recolour</i></span>
              <span><img src={url('assets/adar-mark.svg')} width="40" height="40" alt="" style="filter:drop-shadow(3px 3px 0 #ff8c5f)"><i>add effects</i></span>
            </div><p>Keep the mark upright, in proportion, in fern, ink or bone.</p></div>
          </div>
        </section>

        <!-- Colour -->
        <section class="ds-sec" id="color" aria-labelledby="h-color">
          <header class="ds-sec__head"><p class="eyebrow">03</p><h2 id="h-color">Colour</h2>
            <p>Every colour is named in Basque after something in the forest. Night surfaces carry the interface; the accents are used sparingly and always mean the same thing. Click a swatch to copy it.</p></header>
          <div class="swatches" data-swatches></div>
          <h3 class="ds-h3">Neutrals</h3>
          <div class="ramps" data-ramps></div>
          <h3 class="ds-h3">Semantic tokens</h3>
          <div class="tokens-table card"><table data-tokens>
            <thead><tr><th scope="col">Token</th><th scope="col">Role</th><th scope="col">Night</th><th scope="col">Day</th></tr></thead>
            <tbody></tbody>
          </table></div>
        </section>

        <!-- Type -->
        <section class="ds-sec" id="type" aria-labelledby="h-type">
          <header class="ds-sec__head"><p class="eyebrow">04</p><h2 id="h-type">Typography</h2>
            <p>Geist does the work, Instrument Serif brings the feeling, Geist Mono labels the machine. Use the serif italic for one or two words per heading — never for whole paragraphs.</p></header>
          <div class="faces">
            <article class="face card reveal"><span class="face__aa" style="font-family:var(--font-sans);font-weight:600">Aa</span><h3>Geist</h3><p class="mono muted">--font-sans · 300–700</p><p>Interface, headings and body text. Tight tracking on large sizes.</p></article>
            <article class="face card reveal" style="--delay:60ms"><span class="face__aa serif">Aa</span><h3>Instrument Serif <i>Italic</i></h3><p class="mono muted">--font-serif · 400</p><p>Expressive words in headlines, Basque terms, figure captions.</p></article>
            <article class="face card reveal" style="--delay:120ms"><span class="face__aa mono">Aa</span><h3>Geist Mono</h3><p class="mono muted">--font-mono · 400–600</p><p>Code, SHAs, refs, keyboard shortcuts and eyebrow labels.</p></article>
          </div>
          <div class="scale card">
            <div class="scale__row"><span class="mono">display</span><p style="font-size:var(--text-display);line-height:.95;letter-spacing:-.055em;font-weight:600">See your <span class="serif accent">git</span></p></div>
            <div class="scale__row"><span class="mono">3xl</span><p style="font-size:var(--text-3xl);line-height:1.02;letter-spacing:-.04em;font-weight:600">Pick a branch.</p></div>
            <div class="scale__row"><span class="mono">2xl</span><p style="font-size:var(--text-2xl);font-weight:600;letter-spacing:-.02em">Merge feature/login into main</p></div>
            <div class="scale__row"><span class="mono">xl</span><p style="font-size:var(--text-xl)">Stage files, hunks or single lines.</p></div>
            <div class="scale__row"><span class="mono">md</span><p style="font-size:var(--text-md)">Adar drives the git already installed on your Mac, so it works with the credentials you already use.</p></div>
            <div class="scale__row"><span class="mono">sm</span><p style="font-size:var(--text-sm);color:var(--text-3)">Destructive actions ask first and can be undone.</p></div>
            <div class="scale__row"><span class="mono">mono</span><p class="mono" style="font-size:var(--text-sm)">a0381a2 · origin/main · ⇧⌘F</p></div>
          </div>
        </section>

        <!-- Space -->
        <section class="ds-sec" id="space" aria-labelledby="h-space">
          <header class="ds-sec__head"><p class="eyebrow">05</p><h2 id="h-space">Space, shape &amp; depth</h2>
            <p>A 4 px grid, generous radii and light that comes from the content — glows, not heavy drop shadows.</p></header>
          <div class="space-grid">
            <div class="card space-card"><h3>Spacing</h3><ul class="spacing" data-spacing></ul></div>
            <div class="card space-card"><h3>Radius</h3><div class="radii" data-radii></div></div>
            <div class="card space-card"><h3>Depth &amp; glow</h3><div class="depths">
              <span style="box-shadow:var(--shadow-1)">shadow-1</span><span style="box-shadow:var(--shadow-2)">shadow-2</span><span style="box-shadow:var(--shadow-3)">shadow-3</span><span class="depth-glow" style="box-shadow:var(--glow-accent)">glow-accent</span>
            </div></div>
          </div>
        </section>

        <!-- Motion -->
        <section class="ds-sec" id="motion" aria-labelledby="h-motion">
          <header class="ds-sec__head"><p class="eyebrow">06</p><h2 id="h-motion">Motion</h2>
            <p>Things <i lang="eu">hazi</i> (grow) into place: quick to start, slow to settle. Motion follows the direction of history and is switched off for people who ask for reduced motion.</p></header>
          <div class="curves" data-curves></div>
          <dl class="durations card">
            <div><dt class="mono">--dur-1 · 120ms</dt><dd>Hover, press, colour changes.</dd></div>
            <div><dt class="mono">--dur-2 · 240ms</dt><dd>Toggles, menus, small moves.</dd></div>
            <div><dt class="mono">--dur-3 · 520ms</dt><dd>Panels, cards, notes appearing.</dd></div>
            <div><dt class="mono">--dur-4 · 1100ms</dt><dd>Reveals and lanes drawing themselves.</dd></div>
          </dl>
        </section>

        <!-- Icons -->
        <section class="ds-sec" id="icons" aria-labelledby="h-icons">
          <header class="ds-sec__head"><p class="eyebrow">07</p><h2 id="h-icons">Icons</h2>
            <p>A 24 px grid with 1.75 px round strokes, drawn to sit next to the mark. The app itself uses Lucide; these are the website’s. Click an icon to copy its <code>&lt;use&gt;</code> snippet.</p></header>
          <div class="icons">
            {icons.map((id) => (
              <button type="button" class="icon" data-copy={`<svg><use href="assets/icons.svg#${id}"/></svg>`} title={`Copy ${id}`}>
                <Icon name={id} /><span class="mono" data-label={id}>{id}</span>
              </button>
            ))}
          </div>
        </section>

        <!-- Graph -->
        <section class="ds-sec" id="graph" aria-labelledby="h-graph">
          <header class="ds-sec__head"><p class="eyebrow">08</p><h2 id="h-graph">Graph language</h2>
            <p>The same vocabulary draws the app’s commit graph, the roadmap and the logo. Lanes take colours in a fixed order, so a branch keeps its colour wherever it appears.</p></header>
          <div class="graph-legend card">
            <svg viewBox="0 0 640 210" class="graph-legend__svg" role="img" aria-labelledby="gl-title">
              <title id="gl-title">Graph vocabulary: lanes, commit, merge, work in progress, head and tip</title>
              <g fill="none" stroke-width="3" stroke-linecap="round">
                <path d="M60 196V20" stroke="var(--lane-1)"/>
                <path d="M60 170C60 150 110 156 110 136V60C110 40 60 46 60 26" stroke="var(--lane-2)"/>
                <path d="M60 120C60 100 160 106 160 86V40" stroke="var(--lane-3)" stroke-dasharray="6 6"/>
              </g>
              <circle cx="60" cy="20" r="11" fill="var(--lane-1)" class="gl-head"/>
              <circle cx="60" cy="196" r="9" fill="var(--bg)" stroke="var(--lane-1)" stroke-width="3"/>
              <circle cx="110" cy="100" r="9" fill="var(--bg)" stroke="var(--lane-2)" stroke-width="3"/>
              <circle cx="60" cy="72" r="5" fill="var(--lane-1)"/>
              <circle cx="160" cy="40" r="9" fill="none" stroke="var(--text-3)" stroke-width="2.5" stroke-dasharray="3 3"/>
              <g class="gl-labels">
                <path d="M74 20H230"/><text x="238" y="24">HEAD — filled, glowing: where you are</text>
                <path d="M172 40H230"/><text x="238" y="44">// WIP — dashed ring: not committed yet</text>
                <path d="M68 72H230"/><text x="238" y="80">merge — small filled dot on the target lane</text>
                <path d="M122 100H230"/><text x="238" y="104">commit — ring in its lane colour</text>
                <path d="M168 58H230"/><text x="238" y="60">planned — dashed lane (roadmap)</text>
                <path d="M72 196H230"/><text x="238" y="200">root — the first commit, bottom of the trunk</text>
              </g>
            </svg>
            <div class="lanes" data-lanes></div>
          </div>
        </section>

        <!-- Components -->
        <section class="ds-sec" id="components" aria-labelledby="h-components">
          <header class="ds-sec__head"><p class="eyebrow">09</p><h2 id="h-components">Components</h2>
            <p>The building blocks of the website, each built only from tokens. Flip the preview to see them by day.</p></header>
          <div class="preview card" data-preview>
            <div class="preview__bar">
              <div class="seg" role="radiogroup" aria-label="Theme">
                <button type="button" role="radio" aria-checked="true" data-theme-set="dark">Gaua · night</button>
                <button type="button" role="radio" aria-checked="false" data-theme-set="light">Eguna · day</button>
              </div>
            </div>
            <div class="preview__body">
              <div class="cmp"><span class="cmp__label mono">Buttons</span><div class="cmp__row">
                <a class="btn btn--primary" href="#components"><Icon name="download" />Primary</a>
                <a class="btn" href="#components">Default</a>
                <a class="btn btn--ghost" href="#components">Ghost<Icon name="arrow-right" /></a>
                <a class="btn btn--primary btn--lg" href="#components">Large<span class="btn__meta">meta</span></a>
              </div></div>
              <div class="cmp"><span class="cmp__label mono">Refs</span><div class="cmp__row">
                <span class="ref" style="--ref:var(--lane-1)"><Icon name="laptop" />main</span>
                <span class="ref" style="--ref:var(--lane-2)"><Icon name="laptop" />feature/graph</span>
                <span class="ref" style="--ref:var(--lane-3)"><Icon name="cloud" />origin/main</span>
                <span class="ref" style="--ref:var(--lane-4)"><Icon name="cloud" />origin/experiment</span>
                <span class="ref" style="--ref:var(--lane-6)"><Icon name="tag" />v0.3.1</span>
              </div></div>
              <div class="cmp"><span class="cmp__label mono">Chips &amp; keys</span><div class="cmp__row">
                <span class="chip chip--accent"><span class="dot"></span>New in 0.3.1</span>
                <span class="chip">MIT</span>
                <span class="kbd">⌘</span><span class="kbd">P</span><span class="kbd">⇧⌘F</span>
              </div></div>
              <div class="cmp"><span class="cmp__label mono">Code</span><div class="code"><code><span class="prompt">$</span>adar ~/code/shop</code><button class="copy" type="button" data-copy="adar ~/code/shop" aria-label="Copy command"><Icon name="copy" /><span data-label="Copy">Copy</span></button></div></div>
              <div class="cmp"><span class="cmp__label mono">Card</span><article class="card cmp__card"><span class="eyebrow">Eyebrow</span><h3>A card <span class="serif accent">grows</span></h3><p>Surface, hairline border, a faint top light.</p></article></div>
            </div>
          </div>
        </section>

        <!-- Voice -->
        <section class="ds-sec" id="voice" aria-labelledby="h-voice">
          <header class="ds-sec__head"><p class="eyebrow">10</p><h2 id="h-voice">Voice</h2>
            <p>Plain words, short sentences, and the real git name for things. Say what will happen before it happens.</p></header>
          <div class="voice">
            <div class="voice__col card"><h3 class="voice__do">Do</h3><ul>
              <li>Merge <b>feature/login</b> into <b>main</b></li>
              <li>This branch was already pushed. Saving rewrites it on the remote.</li>
              <li>Undid “Delete branch experiment”</li>
            </ul></div>
            <div class="voice__col card"><h3 class="voice__dont">Don’t</h3><ul>
              <li>Execute merge operation on selected references</li>
              <li>Warning! Are you absolutely sure?</li>
              <li>Oops! Something went wrong 😅</li>
            </ul></div>
          </div>
        </section>

        <!-- Downloads -->
        <section class="ds-sec" id="downloads" aria-labelledby="h-downloads">
          <header class="ds-sec__head"><p class="eyebrow">11</p><h2 id="h-downloads">Downloads</h2>
            <p>Everything is MIT-licensed with the rest of Adar. Use it for articles, talks, forks and integrations — just don’t present a fork as the official Adar.</p></header>
          <div class="downloads">
            <a class="dl-asset card" href={url('assets/adar-mark.svg')} download><img src={url('assets/adar-mark.svg')} width="40" height="40" alt=""><span><b>Mark</b><i class="mono">adar-mark.svg</i></span><Icon name="download" /></a>
            <a class="dl-asset card" href={url('assets/adar-mark-mono.svg')} download><img class="dl-asset__ink" src={url('assets/adar-mark-mono.svg')} width="40" height="40" alt=""><span><b>Mark · ink</b><i class="mono">adar-mark-mono.svg</i></span><Icon name="download" /></a>
            <a class="dl-asset card" href={url('assets/adar-lockup.svg')} download><img src={url('assets/adar-lockup.svg')} width="70" height="24" alt=""><span><b>Lockup · night</b><i class="mono">adar-lockup.svg</i></span><Icon name="download" /></a>
            <a class="dl-asset card" href={url('assets/adar-lockup-light.svg')} download><img class="dl-asset__ink" src={url('assets/adar-lockup-light.svg')} width="70" height="24" alt=""><span><b>Lockup · day</b><i class="mono">adar-lockup-light.svg</i></span><Icon name="download" /></a>
            <a class="dl-asset card" href={url('assets/favicon.svg')} download><img src={url('assets/favicon.svg')} width="40" height="40" alt=""><span><b>App tile</b><i class="mono">favicon.svg</i></span><Icon name="download" /></a>
            <a class="dl-asset card" href={url('assets/icons.svg')} download><Icon name="branch" class="dl-asset__icon" /><span><b>Icon sprite</b><i class="mono">icons.svg</i></span><Icon name="download" /></a>
            <a class="dl-asset card" href={url('tokens.css')} download><Icon name="palette" class="dl-asset__icon" /><span><b>Design tokens</b><i class="mono">tokens.css</i></span><Icon name="download" /></a>
            <a class="dl-asset card" href={url('fonts/LICENSES.md')}><Icon name="code" class="dl-asset__icon" /><span><b>Fonts</b><i class="mono">Geist · Instrument Serif · OFL</i></span><Icon name="arrow-up-right" /></a>
          </div>
        </section>
      </div>
    </div>
  </main>
</Base>

<script>
  import '../scripts/design.js';
</script>
