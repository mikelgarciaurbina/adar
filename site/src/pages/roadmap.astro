---
// The roadmap: ROADMAP.md drawn as a git graph (one dashed branch per area), the changelog from GitHub
// Releases and the contributor path — all rendered at build time; the script only adds the 3D graph
// in the hero and the filters.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/roadmap.css';
import { REPO_URL } from '../lib/url';
import { render } from '../lib/markdown.js';
import { principles, shipped, milestones, limits, stats } from '../lib/roadmap';
import { getReleases, getLatest, formatDate, withoutInstall } from '../lib/releases';

const releases = await getReleases();
const latest = await getLatest();
let lane = 1;
---
<Base
  title="Adar roadmap — where the branches grow next"
  description="Adar's open-source roadmap: what shipped, what comes next, the good first issues waiting for contributors, and the full changelog."
  ogTitle="Adar roadmap"
  ogDescription="Where Adar is heading, what shipped, and how to help."
  path="roadmap.html"
  current="roadmap"
>
  <main id="main">
    <section class="rm-hero" aria-labelledby="rm-title">
      <canvas class="rm-hero__scene" id="scene" aria-hidden="true"></canvas>
      <div class="wrap rm-hero__inner">
        <p class="eyebrow rise">Open-source roadmap</p>
        <h1 id="rm-title" class="rise" style="--delay:80ms">Where Adar <span class="serif">grows next.</span></h1>
        <p class="rm-hero__lede rise" style="--delay:160ms" data-intro>
          Priorities change with feedback: open an issue to discuss an item, vote with 👍 on existing issues, or pick
          something up. Items marked <span class="gfi">good first issue</span> are small and self-contained.
        </p>
        <div class="rm-hero__ctas rise" style="--delay:240ms">
          <button class="btn btn--primary btn--lg" type="button" data-show-gfi><Icon name="sparkle" />Show good first issues</button>
          <a class="btn btn--ghost btn--lg" href="https://github.com/mikelgarciaurbina/adar/issues/new/choose"><Icon name="issue" />Suggest an idea</a>
        </div>
        <dl class="rm-stats rise" style="--delay:320ms">
          <div><dt>Planned</dt><dd>{stats.planned}</dd></div>
          <div><dt>Good first issues</dt><dd>{stats.gfi}</dd></div>
          <div><dt>Areas</dt><dd>{stats.areas}</dd></div>
          <div><dt>Releases</dt><dd>{releases.length || '—'}</dd></div>
        </dl>
      </div>
      <p class="fig rm-hero__fig mono" aria-hidden="true"><span>fig. 4</span> git log --graph --all — <i>the branches still to come</i></p>
    </section>

    <section class="section section--tight rm-principles" aria-labelledby="principles-title">
      <div class="wrap">
        <h2 id="principles-title" class="visually-hidden">Guiding principles</h2>
        <div class="principles">
          {principles.map((p, i) => (
            <article class="principle card reveal" style={`--delay:${i * 60}ms`}>
              <span class="principle__n mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 set:html={p.title} /><p set:html={p.text} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="rm-bar" data-bar>
      <div class="wrap rm-bar__inner">
        <div class="seg" role="group" aria-label="Show">
          <button type="button" aria-pressed="true" data-filter="all">All</button>
          <button type="button" aria-pressed="false" data-filter="next">Next</button>
          <button type="button" aria-pressed="false" data-filter="later">Later</button>
          <button type="button" aria-pressed="false" data-filter="shipped">Shipped</button>
        </div>
        <label class="toggle"><input type="checkbox" data-gfi-toggle><span class="toggle__track"></span>Good first issues</label>
        <label class="rm-search"><Icon name="search" /><input type="search" placeholder="Filter the roadmap…" data-search aria-label="Filter the roadmap"></label>
        <span class="rm-bar__count mono" data-count aria-live="polite"></span>
      </div>
    </div>

    <section class="section rm-list" aria-label="Roadmap">
      <div class="wrap">
        <div class="rm-graph" data-graph>
          {shipped && (
            <section class="rm-ms rm-ms--shipped" data-kind="shipped" id="shipped">
              <header class="rm-ms__head reveal"><span class="rm-ms__node" aria-hidden="true"></span><span class="ref" style="--ref:var(--lane-1)">shipped</span><h2>{shipped.title}</h2><span class="rm-ms__count mono">{shipped.features.length} features</span></header>
              <ul class="rm-shipped reveal">
                {shipped.features.map((f) => <li class="rm-item rm-item--chip" data-gfi="0" data-text={f.text} set:html={f.html} />)}
              </ul>
            </section>
          )}
          <div class="rm-head reveal" aria-label="You are here">
            <span class="rm-head__node" aria-hidden="true"></span>
            <span class="ref" style="--ref:var(--lane-1)"><Icon name="laptop" />HEAD → main</span>
            {latest && <span class="ref" style="--ref:var(--lane-6)"><Icon name="tag" />{latest.tag}</span>}
            <span class="rm-head__label">You are here{latest && ` · ${formatDate(latest.date)}`}</span>
          </div>
          {milestones.map((ms) => (
            <section class={`rm-ms rm-ms--${ms.kind}`} data-kind={ms.kind} id={ms.kind}>
              <header class="rm-ms__head reveal">
                <span class="rm-ms__node" aria-hidden="true"></span>
                <span class="ref" style={`--ref:${ms.kind === 'next' ? 'var(--lane-2)' : 'var(--lane-4)'}`}>{ms.kind}</span>
                <h2>{ms.title}</h2>
                <span class="rm-ms__count mono">{ms.range && `${ms.range} · `}{ms.count} items</span>
              </header>
              {ms.areas.map((area) => (
                <div class="rm-area reveal" id={area.id} style={`--c: var(--lane-${(lane++ % 6) + 1})`}>
                  <svg class="rm-fork" viewBox="0 0 40 44" aria-hidden="true"><path d="M14 0 C14 22 38 18 38 40" /></svg>
                  <h3 class="rm-area__title"><Fragment set:html={area.title} /> <span class="rm-area__count mono">{area.items.length}</span></h3>
                  {area.note && <p class="rm-area__note" set:html={area.note} />}
                  <ul class="rm-items">
                    {area.items.map((it) => (
                      <li class:list={['rm-item', { 'is-gfi': it.gfi, 'is-done': it.done }]} data-gfi={it.gfi ? '1' : '0'} data-text={it.text}>
                        <span class="rm-node" aria-hidden="true"></span>
                        <div class="rm-item__body">
                          <p>
                            <Fragment set:html={it.html} />
                            {it.gfi && <span class="gfi">good first issue</span>}
                            {it.done && <span class="gfi gfi--done">done</span>}
                            <a class="rm-item__link" href={it.discuss}>Discuss<Icon name="arrow-up-right" /></a>
                          </p>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          ))}
        </div>
        <p class="rm-empty" data-empty hidden>Nothing matches that filter — try another word, or <a class="link" href="https://github.com/mikelgarciaurbina/adar/issues/new/choose">suggest it</a>.</p>
      </div>
    </section>

    <section class="section rm-changelog" id="changelog" aria-labelledby="changelog-title">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">Changelog</p>
          <h2 id="changelog-title">Every release, <span class="serif">commit by commit.</span></h2>
          <p>Straight from GitHub Releases — the same notes the in-app updater shows under “What’s new”.</p>
        </div>
        <ol class="releases">
          {releases.map((r, i) => (
            <li class:list={['release', 'reveal', { 'is-latest': r === latest }]}>
              <span class="release__node" aria-hidden="true"></span>
              <div class="release__head">
                <span class="ref" style="--ref:var(--lane-6)"><Icon name="tag" />{r.tag}</span>
                {r === latest && <span class="chip chip--accent"><span class="dot"></span>Latest</span>}
                {r.prerelease && <span class="chip">Pre-release</span>}
                <time class="mono" datetime={r.date}>{formatDate(r.date)}</time>
              </div>
              <h3>{r.name}</h3>
              <div class="release__body md" set:html={render(withoutInstall(r.body))} />
              <a class="release__link" href={r.url}>Release page &amp; downloads<Icon name="arrow-up-right" /></a>
            </li>
          ))}
          {releases.length === 0 && <li class="releases__loading">See <a class="link" href={`${REPO_URL}/releases`}>all releases on GitHub</a>.</li>}
        </ol>
      </div>
    </section>

    <section class="section rm-contribute" id="contribute" aria-labelledby="contribute-title">
      <div class="wrap">
        <div class="section-head section-head--center reveal">
          <p class="eyebrow">Contribute</p>
          <h2 id="contribute-title">Pick a branch. <span class="serif">Make it grow.</span></h2>
          <p>Adar is small enough that one pull request changes it. Here is the shortest path from idea to merge.</p>
        </div>
        <ol class="steps">
          <li class="step card reveal"><span class="step__n mono">1</span><h3>Choose</h3><p>Take a <button class="link-btn" type="button" data-show-gfi>good first issue</button> or <a class="link" href="https://github.com/mikelgarciaurbina/adar/issues">an open issue</a>. Say you’re on it so nobody duplicates work.</p></li>
          <li class="step card reveal" style="--delay:60ms"><span class="step__n mono">2</span><h3>Set up</h3><div class="code"><code><span class="prompt">$</span>npm install &amp;&amp; npm run dev</code><button class="copy" type="button" data-copy="npm install && npm run dev" aria-label="Copy command"><Icon name="copy" /><span data-label="Copy">Copy</span></button></div></li>
          <li class="step card reveal" style="--delay:120ms"><span class="step__n mono">3</span><h3>Read the map</h3><p><a class="link" href="https://github.com/mikelgarciaurbina/adar/blob/main/AGENTS.md">AGENTS.md</a> explains the architecture, conventions and safety rules.</p></li>
          <li class="step card reveal" style="--delay:180ms"><span class="step__n mono">4</span><h3>Open a PR</h3><p>Keep it focused, run <code>npm run typecheck</code> and <code>npm test</code>, and follow <a class="link" href="https://github.com/mikelgarciaurbina/adar/blob/main/CONTRIBUTING.md">CONTRIBUTING.md</a>.</p></li>
        </ol>
        {limits && (
          <details class="limits reveal">
            <summary><span>{limits.title}</span><span class="mono muted">{limits.items.length}</span></summary>
            <ul>{limits.items.map((l) => <li set:html={l} />)}</ul>
          </details>
        )}
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/roadmap.js';
</script>
