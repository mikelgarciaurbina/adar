{
  "name": "adar",
  "productName": "Adar",
  "version": "0.30.0",
  "description": "Adar — a fast, visual Git client for any repository (public or private)",
  "author": "Mikel García",
  "license": "MIT",
  "homepage": "https://github.com/mikelgarciaurbina/adar",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikelgarciaurbina/adar.git"
  },
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD --passWithNoTests",
    "test:related": "vitest related --run",
    "test:watch": "vitest watch",
    "web": "node scripts/web-dev.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
