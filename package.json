{
  "name": "adar",
  "productName": "Adar",
  "version": "0.6.2",
  "description": "Adar — a fast, visual Git client for any repository (public or private)",
  "author": "Mikel García",
  "license": "MIT",
  "homepage": "https://github.com/mikelgarciaurbina/adar",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikelgarciaurbina/adar.git"
  },
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "web": "node scripts/web-dev.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.21",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
